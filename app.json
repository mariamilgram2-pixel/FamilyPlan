{
  "expo": {
    "name": "sheep",
    "slug": "familyplan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.familyplan.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C4B5A0"
      },
      "package": "com.familyplan.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "familyplan",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#C4B5A0"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow FamilyPlan to use Face ID to authenticate."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow sheep to access your photos so you can import a work schedule screenshot.",
          "cameraPermission": false
        }
      ],
      "expo-font"
    ]
  }
}
